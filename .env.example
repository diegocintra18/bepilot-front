# Base URL da API BePilot (Vite injeta como import.meta.env.VITE_API_BASE_URL)
#
# Produção: URL absoluta da API. Requer que a API envie os cabeçalhos de CORS
# (Access-Control-Allow-Origin) para o domínio do frontend.
VITE_API_BASE_URL=https://api.vouserpiloto.com.br/api/v1

# Desenvolvimento: caminho relativo, roteado pelo proxy do Vite (vite.config.js)
# para evitar o preflight de CORS. Copie para .env.development.
# VITE_API_BASE_URL=/api/v1
